FROM pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace/Multi-Agent-Transformer \
    SC2PATH=/workspace/Multi-Agent-Transformer/3rdparty/StarCraftII

WORKDIR /workspace/Multi-Agent-Transformer

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    libgl1 \
    libglib2.0-0 \
    libosmesa6 \
    libsm6 \
    libxext6 \
    libxrender1 \
    procps \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements-smac.txt /tmp/requirements-smac.txt
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python -m pip install --no-cache-dir -r /tmp/requirements-smac.txt

COPY . /workspace/Multi-Agent-Transformer

CMD ["/bin/bash"]
