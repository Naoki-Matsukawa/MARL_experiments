FROM pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace/Multi-Agent-Transformer

WORKDIR /workspace/Multi-Agent-Transformer

# Google Research Football's C++ engine (gfootball) builds from source on
# pip/uv install, so it needs a full toolchain + SDL2/Boost at build time.
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    cmake \
    build-essential \
    libgl1-mesa-dev \
    libsdl2-dev \
    libsdl2-image-dev \
    libsdl2-ttf-dev \
    libsdl2-gfx-dev \
    libboost-all-dev \
    libdirectfb-dev \
    mesa-utils \
    xvfb \
    x11vnc \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# gfootball ships a prebuilt game-engine .so linked against a newer
# libstdc++ (GLIBCXX_3.4.30+) than the conda base env bundles; update
# conda's copy so the RPATH-resolved library satisfies it.
RUN conda install -y -c conda-forge "libstdcxx-ng>=12" && conda clean -afy

COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /usr/local/bin/uv

COPY docker/football/pyproject.toml docker/football/uv.lock /tmp/football-project/
RUN cd /tmp/football-project \
    && uv export --frozen --no-hashes -o requirements.lock.txt \
    && uv pip install --system --no-cache -r requirements.lock.txt

COPY . /workspace/Multi-Agent-Transformer

CMD ["/bin/bash"]
